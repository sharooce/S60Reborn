<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0F1115">

    <!-- Header Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="#1E1E1E"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="SISX Explorer"
            android:textColor="#00E676"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnExplorerBack"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:background="@drawable/fab_mini_bg"
            android:text="Tutup"
            android:textColor="#CFD8DC"
            android:textSize="11sp"
            android:paddingHorizontal="8dp" />
    </LinearLayout>

    <!-- Status / Info Bar -->
    <TextView
        android:id="@+id/tvExplorerStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:text="Memuat..."
        android:textColor="#90A4AE"
        android:textSize="10.5sp"
        android:background="#14171C" />

    <!-- ListView Daftar File (Dibuat kustom via Adapter agar ukuran teks kecil) -->
    <ListView
        android:id="@+id/lvExplorerFiles"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@android:color/transparent"
        android:divider="@android:color/transparent"
        android:dividerHeight="2dp"
        android:padding="4dp" />

    <!-- Footer Tombol Rebuild -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="10dp"
        android:background="#1E1E1E">

        <Button
            android:id="@+id/btnRebuildFromExplorer"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:background="@drawable/fab_mini_bg"
            android:text="🛠️  Rebuild ke .SISX Baru"
            android:textColor="#00E676"
            android:textStyle="bold"
            android:textSize="12sp" />
    </LinearLayout>

</LinearLayout>

