<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_glass_bg"
    android:orientation="vertical"
    android:padding="18dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/add_file_title"
        android:textColor="@color/accent_green"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvAddFileName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:paddingBottom="12dp"
        android:textColor="@color/text_primary"
        android:textSize="13sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/add_file_folder_label"
        android:textColor="@color/text_muted"
        android:textSize="12sp" />

    <Spinner
        android:id="@+id/spTargetFolder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="8dp"
        android:background="@color/bg_spinner_dark" />

    <EditText
        android:id="@+id/etCustomTarget"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/input_modern"
        android:hint="@string/add_file_custom_hint"
        android:paddingStart="10dp"
        android:paddingTop="8dp"
        android:paddingEnd="10dp"
        android:paddingBottom="8dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_hint"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="14dp">

        <Button
            android:id="@+id/btnAddCancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@color/bg_btn_neutral"
            android:text="@string/btn_cancel"
            android:textColor="@color/text_primary" />

        <Button
            android:id="@+id/btnAddConfirm"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.3"
            android:background="@color/accent_green"
            android:text="@string/btn_add"
            android:textColor="@color/text_on_accent"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>

